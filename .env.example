# Used by the conductor. Create the database before starting it.
DATABASE_URL=postgres://postgres:your-password@127.0.0.1:5432/townwarz
# Used by the gateway. Match the React client's Auth0 SPA configuration.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id

# Optional conductor-only Mayor income tuning (normal gameplay defaults).
TWZ_MAYOR_INCOME_AMOUNT=100
TWZ_MAYOR_INCOME_INTERVAL_MS=3000
