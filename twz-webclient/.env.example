# Auth0 application type: Single Page Application. No client secret is needed.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
# Optional. Defaults to the current page origin.
VITE_AUTH0_REDIRECT_URI=http://localhost:5173
# Local Rust gateway. Docker supervisor defaults to port 8080 instead.
VITE_GAME_WS_URL=ws://localhost:8081/play
